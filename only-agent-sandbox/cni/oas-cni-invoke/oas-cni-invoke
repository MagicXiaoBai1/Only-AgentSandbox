#!/usr/bin/env python3
"""Minimal CNI conflist invoker for OAS (no libcni / no Go deps).

Usage:
  oas-cni-invoke add  --config FILE --netns PATH --id ID [--ifname eth0] [--cni-path DIR]
  oas-cni-invoke del  --config FILE --netns PATH --id ID [--ifname eth0] [--cni-path DIR]
  oas-cni-invoke check --config FILE --netns PATH --id ID ...

Prints final CNI result JSON on stdout for add.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


def die(msg: str, code: int = 1) -> None:
    print(f"oas-cni-invoke: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_conflist(path: Path) -> dict[str, Any]:
    data = json.loads(path.read_text())
    if "plugins" not in data:
        die(f"{path}: not a conflist (missing plugins)")
    return data


def find_plugin(cni_paths: list[str], typ: str) -> Path:
    for d in cni_paths:
        cand = Path(d) / typ
        if cand.is_file() and os.access(cand, os.X_OK):
            return cand
    die(f"plugin {typ!r} not found in {cni_paths}")


def run_plugin(
    plugin: Path,
    command: str,
    plugin_conf: dict[str, Any],
    *,
    container_id: str,
    netns: str,
    ifname: str,
    cni_path: str,
) -> dict[str, Any] | None:
    env = os.environ.copy()
    env.update(
        {
            "CNI_COMMAND": command,
            "CNI_CONTAINERID": container_id,
            "CNI_NETNS": netns,
            "CNI_IFNAME": ifname,
            "CNI_PATH": cni_path,
            "CNI_ARGS": env.get("CNI_ARGS", ""),
        }
    )
    stdin = json.dumps(plugin_conf).encode()
    proc = subprocess.run(
        [str(plugin)],
        input=stdin,
        capture_output=True,
        env=env,
    )
    if proc.returncode != 0:
        err = proc.stderr.decode(errors="replace").strip()
        out = proc.stdout.decode(errors="replace").strip()
        die(f"{plugin.name} {command} failed ({proc.returncode}): {err or out}")
    raw = proc.stdout.decode().strip()
    if command == "DEL" or not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"{plugin.name} returned non-JSON: {raw[:200]} ({e})")


def cmd_add(args: argparse.Namespace) -> None:
    conflist = load_conflist(Path(args.config))
    cni_paths = args.cni_path.split(":")
    name = conflist.get("name", "oas")
    cni_version = conflist.get("cniVersion", "1.0.0")
    prev: dict[str, Any] | None = None

    for plugin_conf in conflist["plugins"]:
        typ = plugin_conf.get("type")
        if not typ:
            die("plugin missing type")
        conf = dict(plugin_conf)
        conf.setdefault("name", name)
        conf.setdefault("cniVersion", cni_version)
        if prev is not None:
            conf["prevResult"] = prev
        plugin = find_plugin(cni_paths, typ)
        prev = run_plugin(
            plugin,
            "ADD",
            conf,
            container_id=args.id,
            netns=args.netns,
            ifname=args.ifname,
            cni_path=args.cni_path,
        )
        if prev is None:
            die(f"{typ} ADD returned empty result")

    json.dump(prev, sys.stdout)
    sys.stdout.write("\n")


def cmd_del(args: argparse.Namespace) -> None:
    conflist = load_conflist(Path(args.config))
    cni_paths = args.cni_path.split(":")
    name = conflist.get("name", "oas")
    cni_version = conflist.get("cniVersion", "1.0.0")
    # DEL in reverse order
    for plugin_conf in reversed(conflist["plugins"]):
        typ = plugin_conf.get("type")
        conf = dict(plugin_conf)
        conf.setdefault("name", name)
        conf.setdefault("cniVersion", cni_version)
        plugin = find_plugin(cni_paths, typ)
        try:
            run_plugin(
                plugin,
                "DEL",
                conf,
                container_id=args.id,
                netns=args.netns,
                ifname=args.ifname,
                cni_path=args.cni_path,
            )
        except SystemExit:
            # best-effort teardown
            continue


def cmd_check(args: argparse.Namespace) -> None:
    # Minimal: re-run ADD path semantics via CHECK on last plugin only if needed.
    # For lab, invoke CHECK on each plugin with empty prev — skip unless requested later.
    print(json.dumps({"ok": True}))


def main() -> None:
    p = argparse.ArgumentParser(prog="oas-cni-invoke")
    p.add_argument("command", choices=["add", "del", "check"])
    p.add_argument("--config", required=True)
    p.add_argument("--netns", required=True)
    p.add_argument("--id", required=True)
    p.add_argument("--ifname", default="eth0")
    p.add_argument(
        "--cni-path",
        default="/opt/cni/bin",
        help="colon-separated plugin dirs",
    )
    args = p.parse_args()
    if args.command == "add":
        cmd_add(args)
    elif args.command == "del":
        cmd_del(args)
    else:
        cmd_check(args)


if __name__ == "__main__":
    main()
